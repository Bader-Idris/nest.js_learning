generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma" // if you use this output,
  // you have to update the service import @prisma/client to this new path
  // ../../generated/prisma
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // for testing, we'll use a dev dep named: dotenv-cli to be used in package file instead of handling envFilePath here with many headaches
  // prepend this "dotenv -e .env.test --" to make its .env file as your customized one!
}

